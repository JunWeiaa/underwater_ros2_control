<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>real_underwater_hardware</name>
  <version>0.0.0</version>
  <description>ros2_control hardware interface for real underwater robots using MAVROS and servo actuators.</description>
  <maintainer email="weijunn@hnu.edu.cn">Jun Wei</maintainer>
  <author email="weijunn@hnu.edu.cn">Jun Wei</author>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>rclcpp</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>mavros_msgs</depend>
  <depend>realtime_tools</depend>
  <depend>sensor_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <test_depend>ament_cmake_gmock</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>controller_manager</test_depend>
  <test_depend>hardware_interface</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
