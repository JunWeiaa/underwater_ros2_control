<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
<link name="base_link">
  <inertial>
    <origin xyz="0 0 0.011" rpy="0 0 0"/>
    <mass value="11.5"/>
    <inertia ixx="0.16" ixy="0" ixz="0" iyy="0.16" iyz="0" izz="0.16"/>
  </inertial>
  <visual name="base_link_visual">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://bluerov2_heavy/meshes/bluerov2_heavy.dae" scale="0.025 0.025 0.025"/>
    </geometry>
  </visual>
  <collision name="base_link_collision">
    <origin xyz="0.0 0.0 0.06" rpy="0 0 0"/>
    <geometry>
      <box size="0.457 0.575 0.05"/>
    </geometry>
  </collision>
  </link>

</robot>