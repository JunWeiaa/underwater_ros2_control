<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Hydrodynamics plugin -->
  <gazebo>
    <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <water_density>1000.0</water_density>
      <xU>-4.03</xU>
      <yV>-6.22</yV>
      <zW>-5.18</zW>
      <kP>-0.07</kP>
      <mQ>-0.07</mQ>
      <nR>-0.07</nR>
      <xUabsU>-18.18</xUabsU>
      <yVabsV>-21.66</yVabsV>
      <zWabsW>-36.99</zWabsW>
      <kPabsP>-1.55</kPabsP>
      <mQabsQ>-1.55</mQabsQ>
      <nRabsR>-1.55</nRabsR>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>1000</odom_publish_frequency>
    </plugin>
    <plugin name="gz_underwater_hardware::GazeboSimUnderwaterPlugin" filename="gz_underwater_hardware-system">
      <parameters>$(find bluerov2_heavy)/config/gazebo.yaml</parameters>
      <thruster_coefficient>1.5625 1.5625 -1.5625 -1.5625 1.5625 1.5625 1.5625 1.5625</thruster_coefficient>
      <propeller_diameter>0.02 0.02 0.02 0.02 0.02 0.02 0.02 0.02</propeller_diameter>
      <thruster_num>8</thruster_num>
    </plugin>
  </gazebo>
    <!-- ros2_control系统 -->
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_underwater_hardware/GazeboSimSystem</plugin>
      </hardware>
      <!-- 8个推进器joint接口，建议用xacro宏 -->
      <xacro:macro name="thruster_control_interface" params="num">
        <joint name="thruster${num}_joint">
          <command_interface name="velocity"/>
          <command_interface name="thrust"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:macro>
      <xacro:thruster_control_interface num="1"/>
      <xacro:thruster_control_interface num="2"/>
      <xacro:thruster_control_interface num="3"/>
      <xacro:thruster_control_interface num="4"/>
      <xacro:thruster_control_interface num="5"/>
      <xacro:thruster_control_interface num="6"/>
      <xacro:thruster_control_interface num="7"/>
      <xacro:thruster_control_interface num="8"/>
      <sensor name="imu_sensor">
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
      </sensor>
    </ros2_control>

</robot>