# Target presets for subcat.
# Coordinates are ENU by default: x east, y north, z up.
# Select one preset from the controller YAML with trajectory.target_name.
# TargetManager converts it to NED/FRD before passing it to the controller.

[circle]
type = circle
frame = enu
duration = 80.0
radius = 2.0
center = [0.0, 0.0, -2.0]
start_angle = 0.0

[figure8]
type = figure8
frame = enu
duration = 100.0
x_amplitude = 2.4
y_amplitude = 1.2
z_amplitude = 0.0
center = [0.0, 0.0, -2.0]
start_phase = 0.0
